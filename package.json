    "main": "src/index.ts",
    "scripts": {
        "build": "npm run build:esbuild && npm run build:vite",
        "build:esbuild": "tsc && node esbuild.mts",
        "build:vite": "vite build web",
        "dev": "concurrently --kill-others -n esbuild,vite 'npm run dev:esbuild' 'npm run dev:vite'",
        "dev:esbuild": "tsc && node esbuild.mts && node --enable-source-maps dist/index.js",
        "dev:vite": "vite web",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "clean": "rm -rf dist",
        "start": "node --enable-source-maps dist/index.js"
    },
    "dependencies": {
        "bme280": "^2.1.1",
        "body-parser": "^2.3.0",
        "canvas": "^3.2.3",
        "chart.js": "^4.5.1",
        "chartjs-adapter-moment": "^1.0.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "it8951": "^0.1.1",
        "moment": "^2.31.0",
        "moment-timezone": "^0.6.4",
        "pigpio": "^3.3.1",
        "serialport": "^13.0.0",
        "suncalc": "^2.0.2",
        "xml2js": "^0.6.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsoneditor": "^9.9.6",
        "@types/node": "^22.20.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/suncalc": "^1.9.2",
        "@types/xml2js": "^0.4.14",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "esbuild": "^0.28.2",
        "esbuild-register": "^3.6.0",
        "jsoneditor": "^10.4.3",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    },
    "engines": {
        "node": ">=22.0.0"
